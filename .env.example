# Copy to .env and adjust. docker compose reads .env automatically; for the `mc`
# CLI, load it with `uv run --env-file .env mc ...` (or export the variables).
# Every variable is optional: the defaults below are what the code uses without a .env.

# Host port the Postgres container is published on (docker-compose.yml).
MC_DB_PORT=5433

# Connection string used by the `mc` CLI and the scripts. If unset, it is built from
# MC_DB_PORT with the compose file's user/password/database.
MC_DATABASE_URL=postgresql://music:music@localhost:5433/music_connector

# Hugging Face model id for the embedder. The weights are CC BY-NC 4.0 (see NOTICE).
MC_MODEL_ID=OpenMuQ/MuQ-MuLan-large

# Optional Hugging Face settings: where the ~2.5 GB of weights are cached, and a token
# only if you hit rate limits. Never commit a real token.
# HF_HOME=~/.cache/huggingface
# HF_TOKEN=
